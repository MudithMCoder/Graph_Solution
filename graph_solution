#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"
cd "$SCRIPT_DIR"

BIN="build/bin"

# --- toolchain sanity checks ---
if ! command -v make >/dev/null 2>&1; then
    echo "Error: 'make' not found. Install it, e.g.: sudo apt-get install build-essential" >&2
    exit 1
fi
if ! command -v g++ >/dev/null 2>&1; then
    echo "Error: 'g++' not found. Install it, e.g.: sudo apt-get install build-essential" >&2
    exit 1
fi

# --- execute make ---
make --silent --no-print-directory

# --- run ---
exec "$BIN" "$@"